# === Telegram User API (my.telegram.org) ===
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+821012345678

# === Telegram Bot API (@BotFather) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_REPORT_CHAT_ID=your_chat_id_here

# === Discord Webhook (optional; 설정 시 텔레그램 대신 Discord로 발송) ===
DISCORD_WEBHOOK_URL=

# === Gemini API (aistudio.google.com) ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Obsidian Vault ===
OBSIDIAN_VAULT_PATH=D:/ObsidianVault
OBSIDIAN_FOLDER=Stock-Surge

# === Optional ===
# SESSION_NAME=surge_bot
# LOG_LEVEL=INFO
# WATCH_SCORE_THRESHOLD=6.0
# BATCH_INTERVAL_MINUTES=30
